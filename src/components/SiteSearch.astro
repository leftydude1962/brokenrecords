---
// Header search box. Without JavaScript it is a plain form that opens /search?q=.
// With JavaScript it shows matching records as you type.
const q = Astro.url.searchParams.get("q") ?? "";
---
<form class="site-search" action="/search" method="get" role="search">
  <label class="sr-only" for="site-search-q">Search records</label>
  <input
    id="site-search-q"
    name="q"
    type="search"
    value={q}
    placeholder="Search records"
    autocomplete="off"
    spellcheck="false"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="site-search-list"
  />
  <ul id="site-search-list" class="ss-list" role="listbox" hidden></ul>
</form>

<script>
  import { search, type IndexItem } from "../lib/search";

  const form = document.querySelector<HTMLFormElement>(".site-search")!;
  const input = form.querySelector<HTMLInputElement>("input")!;
  const list = form.querySelector<HTMLUListElement>(".ss-list")!;
  let index: IndexItem[] | null = null;
  let loading: Promise<void> | null = null;
  let active = -1;

  const load = () =>
    (loading ??= fetch("/search-index.json")
      .then((r) => (r.ok ? r.json() : []))
      .then((d) => { index = d; })
      .catch(() => { index = []; }));

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]!));

  function close() {
    list.hidden = true;
    input.setAttribute("aria-expanded", "false");
    input.removeAttribute("aria-activedescendant");
    active = -1;
  }

  function render() {
    const q = input.value.trim();
    if (!index || q.length < 2) return close();
    const hits = search(index, q, 8);
    if (!hits.length) {
      list.innerHTML = `<li class="ss-empty">No records match. Press Enter to search anyway.</li>`;
    } else {
      list.innerHTML =
        hits.map((h, i) =>
          `<li role="option" id="ss-opt-${i}"><a href="/records/${encodeURIComponent(h.s)}"><span class="ss-t">${esc(h.t)}</span><span class="ss-m">${esc([h.v, h.h].filter(Boolean).join(" · "))}</span></a></li>`
        ).join("") +
        `<li class="ss-all"><a href="/search?q=${encodeURIComponent(q)}">See all results for “${esc(q)}”</a></li>`;
    }
    list.hidden = false;
    input.setAttribute("aria-expanded", "true");
    active = -1;
  }

  function move(step: number) {
    const opts = list.querySelectorAll<HTMLLIElement>('[role="option"]');
    if (!opts.length) return;
    opts[active]?.classList.remove("on");
    active = (active + step + opts.length) % opts.length;
    opts[active].classList.add("on");
    input.setAttribute("aria-activedescendant", opts[active].id);
  }

  input.addEventListener("focus", () => { load().then(render); });
  input.addEventListener("input", () => { load().then(render); });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Escape") { close(); }
    else if (e.key === "Enter" && active >= 0) {
      const a = list.querySelectorAll<HTMLLIElement>('[role="option"]')[active]?.querySelector("a");
      if (a) { e.preventDefault(); location.href = a.href; }
    }
  });
  document.addEventListener("click", (e) => { if (!form.contains(e.target as Node)) close(); });
</script>

<style>
  .site-search { position: relative; flex: 1 1 16rem; max-width: 28rem; margin: 0 1.25rem; }
  .site-search input {
    width: 100%; font: 500 1rem/1.2 var(--display); padding: 0.55rem 0.8rem;
    border: 1px solid #3a4a5a; border-radius: 4px; background: #1b2631; color: #fff;
  }
  .site-search input::placeholder { color: #8fa0b0; }
  .site-search input:focus { outline: 3px solid var(--amber); outline-offset: 1px; border-color: transparent; }
  .ss-list {
    position: absolute; left: 0; right: 0; top: calc(100% + 0.35rem); z-index: 20; list-style: none; margin: 0; padding: 0.3rem 0;
    background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35); max-height: 70vh; overflow-y: auto;
  }
  .ss-list a { display: grid; gap: 0.1rem; padding: 0.5rem 0.8rem; text-decoration: none; color: inherit; }
  .ss-list li.on a, .ss-list a:hover { background: var(--rule); }
  .ss-t { font: 700 0.98rem/1.25 var(--display); }
  .ss-m { font: 500 0.82rem/1.3 var(--display); color: var(--ink-soft); }
  .ss-all a { font: 700 0.85rem/1.3 var(--display); color: var(--link); border-top: 1px solid var(--rule); }
  .ss-empty { padding: 0.6rem 0.8rem; font: 500 0.9rem/1.3 var(--display); color: var(--ink-soft); }
  @media (max-width: 40rem) {
    .site-search { order: 3; flex-basis: 100%; max-width: none; margin: 0.75rem 0 0; }
  }
</style>
