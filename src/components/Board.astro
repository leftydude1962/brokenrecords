---
import { formatValue, type RecordRow } from "../lib/data";
interface Props {
  record: RecordRow;
  heading?: "h1" | "h2" | "p";
  link?: boolean;
  showTitle?: boolean;
}
const { record, heading = "p", link = false, showTitle = true } = Astro.props;
const { value, unit } = formatValue(record);
const chars = [...value];
// Location and the year the record was set. The year alone avoids wording that fits
// some records and not others (a building opening date versus a person's final age).
const year = record.achieved_on ? record.achieved_on.slice(0, 4) : null;
const meta = [record.location, year].filter(Boolean).join(", ");
const Title = heading;
---
<section class="board" aria-label={`${record.title}: ${value} ${unit}, ${record.holder ?? ""}`}>
  {showTitle && (
    <Title class="board-title">
      {link ? <a href={`/records/${record.slug}`} style="color:inherit">{record.title}</a> : record.title}
    </Title>
  )}
  <div class="flaps" aria-hidden="true">
    <span class="digits" data-flap>
      {chars.map((c) => <span class:list={["ch", { sep: c === "." || c === "," || c === " " }]}>{c}</span>)}
    </span>
    <span class="flap-unit">{unit}</span>
  </div>
  {record.holder && <p class="board-holder">{record.holder}</p>}
  {meta && <p class="board-meta">{meta}</p>}
</section>
