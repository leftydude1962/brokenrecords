---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: unknown;
  image?: string | null;
}
const { title, description, noindex = false, jsonLd, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Broken Records" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image.split("?")[0]} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="wordmark" href="/" aria-label="Broken Records home"><span class="crack" data-text="Broken">Broken</span> Records</a>
        <nav aria-label="Main">
          <a href="/category">Categories</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>
          Broken Records tracks recognized world records and links every entry to its sources. Each record shows the date we last checked it.
          We are not an official certifying body.
        </p>
        <p class="fine">Record data from Wikidata (CC0) and the sources listed on each page.</p>
        <p class="fine">A brand of <a href="https://mohrcreativegroup.com" rel="noopener">Mohr Creative Group</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #eceff1;
    --ink: #17212b;
    --ink-soft: #4a5866;
    --rule: #c7ced5;
    --board: #1e2935;
    --night: #121a22;
    --flap: #2b3947;
    --amber: #f2b33d;
    --red: #c8102e;
    --link: #1d5c8f;
    --display: "Archivo", "Arial Narrow", sans-serif;
    --serif: "Source Serif 4", Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #121a22;
      --ink: #e6ebef;
      --ink-soft: #a3b0bc;
      --rule: #2c3a47;
      --board: #0d141b;
      --night: #0a1016;
      --flap: #1e2935;
      --link: #8cc2ee;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 400 1.0625rem/1.65 var(--serif);
  }
  .wrap { max-width: 120rem; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 48rem) { .wrap { padding: 0 2rem; } }
  @media (min-width: 80rem) { .wrap { padding: 0 3rem; } }
  a { color: var(--link); text-underline-offset: 0.18em; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; border-radius: 2px; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.1; margin: 0; }
  h1 { font-weight: 850; font-stretch: 112%; font-size: clamp(2rem, 1.3rem + 3vw, 3.4rem); letter-spacing: -0.015em; }
  h2 { font-weight: 800; font-stretch: 100%; font-size: 1.5rem; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--amber); color: #000; padding: 0.5rem 0.75rem; z-index: 10; }

  .site-head { background: var(--night); color: #fff; }
  .head-row { display: flex; align-items: baseline; justify-content: space-between; padding-top: 1rem; padding-bottom: 1rem; }
  .wordmark {
    font-family: var(--display); font-weight: 900; font-stretch: 125%; font-size: 1.35rem;
    color: #fff; text-decoration: none; letter-spacing: -0.01em;
  }
  /* "Broken" is drawn twice and clipped into two halves; the lower half slips and tilts. */
  .crack { position: relative; display: inline-block; color: transparent; }
  .crack::before, .crack::after { content: attr(data-text); position: absolute; inset: 0; color: var(--amber); }
  .crack::before { clip-path: polygon(0 0, 100% 0, 100% 40%, 66% 62%, 36% 42%, 0 60%); }
  .crack::after { clip-path: polygon(0 60%, 36% 42%, 66% 62%, 100% 40%, 100% 100%, 0 100%); transform: translate(3px, 3px) rotate(2deg); }
  .site-head nav a { font-family: var(--display); font-weight: 600; color: #d5dde4; text-decoration: none; }
  .site-head nav a:hover { text-decoration: underline; }

  main { padding-bottom: 4rem; }
  .band { background: var(--night); color: #fff; padding-bottom: 3rem; }
  .band a { color: #f6c868; }
  .band .muted { color: #a9b6c2; }
  .site-foot { border-top: 1px solid var(--rule); color: var(--ink-soft); font-size: 0.95rem; padding: 2rem 0 3rem; }
  .site-foot p { max-width: 62ch; margin: 0 0 0.5rem; }
  .site-foot .fine { font-size: 0.85rem; }

</style>
