---
import Base from "../layouts/Base.astro";
import LatestRecords from "../components/LatestRecords.astro";
import TipPrompt from "../components/TipPrompt.astro";
import AlertSignup from "../components/AlertSignup.astro";
import { getLatest } from "../lib/latest";
import { cacheFor } from "../lib/data";

const items = await getLatest(48);
cacheFor(3600, Astro.response);
---
<Base title="Latest world records | Broken Records" description="World records we added or updated in the last month, including records set a little earlier. Checked daily, with sources.">
  <div class="wrap">
    <LatestRecords items={items} heading="Recently added records" showAllLink={false} />
    {items.length === 0 && <p>Nothing new in the last 30 days. Check back tomorrow.</p>}
    <AlertSignup source="latest" />
    <TipPrompt variant="band" />
  </div>
</Base>
