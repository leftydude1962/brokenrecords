---
import Base from "../layouts/Base.astro";
// Private review page for record corrections. Only the owner's account can use it.
// The server checks the account on every request, so this page is not the only guard.
const supabaseUrl = "https://ccwmynoumrqpvnmpcgch.supabase.co";
const publishableKey = "sb_publishable_XQGLSf28dqucKBAaV4XC4A_znvwj3Z5";
---

<Base title="Admin | Broken Records" description="Private page." noindex={true}>
  <div class="admin wrap">
    <h1>Admin</h1>

    <section id="login" hidden>
      <p>Enter your email. We send a sign-in link.</p>
      <form id="login-form">
        <input type="email" id="login-email" required autocomplete="email" placeholder="you@example.com" />
        <button type="submit">Send sign-in link</button>
      </form>
      <p id="login-status" role="status"></p>
    </section>

    <div id="signed-in" hidden>
      <div class="admin-bar">
        <nav class="tabs" aria-label="Admin sections">
          <button type="button" class="tab" data-tab="dash" aria-pressed="true">Today</button>
          <button type="button" class="tab" data-tab="tips" aria-pressed="false">Tips <span id="tip-count"></span></button>
          <button type="button" class="tab" data-tab="queue" aria-pressed="false">Corrections <span id="count"></span></button>
        </nav>
        <button type="button" id="signout">Sign out</button>
      </div>

      <section id="dash">
        <p id="dash-status" role="status"></p>
        <div id="dash-body" hidden>
          <p class="runline" id="runline"></p>

          <div class="tiles">
            <div class="tile"><span class="n" id="t-new"></span><span class="l">New records found today</span></div>
            <div class="tile"><span class="n" id="t-broken"></span><span class="l">Records broken today</span></div>
            <div class="tile"><span class="n" id="t-live"></span><span class="l">Live records</span></div>
            <div class="tile"><span class="n" id="t-wait"></span><span class="l">Waiting for review</span></div>
            <div class="tile"><span class="n" id="t-subs"></span><span class="l">Email subscribers</span></div>
          </div>

          <h2>Found today by the news check</h2>
          <ul class="finds" id="finds"></ul>

          <h2>Last 14 days</h2>
          <p class="hint">Bars: records the news check found each day. Hover a bar for the numbers.</p>
          <div class="chart" id="chart" role="img" aria-label="Records found by the news check per day"></div>
          <details class="daily">
            <summary>Show as a table</summary>
            <table>
              <thead><tr><th>Day</th><th>Found by news check</th><th>Went live</th><th>All records added</th><th>Broken</th><th>Search cost</th></tr></thead>
              <tbody id="daily-rows"></tbody>
            </table>
          </details>

          <h2>Audience</h2>
          <div class="cols">
            <ul class="kv" id="audience"></ul>
            <div>
              <p class="hint">Your list belongs to you. Download it any time for a backup or to move it to another service.</p>
              <button type="button" id="export-subs">Download subscribers (CSV)</button>
              <p id="export-status" role="status"></p>
            </div>
          </div>

          <div class="cols">
            <div>
              <h2>Waiting for you</h2>
              <ul class="kv" id="queues"></ul>
            </div>
            <div>
              <h2>Site health</h2>
              <ul class="kv" id="health"></ul>
            </div>
          </div>

          <h2>Searches with no result</h2>
          <p class="hint">What visitors looked for and did not find. Good candidates for new records.</p>
          <ul class="kv" id="misses"></ul>
        </div>
      </section>

      <section id="tips" hidden>
        <p class="hint">Tips from the public form are researched within about 10 minutes. A tip that passes every check goes live by itself and you get an email. Only the ones that need a decision wait here, with the reason.</p>
        <p id="tips-status" role="status"></p>
        <ul id="tip-items" class="items"></ul>
      </section>

      <section id="queue" hidden>
        <p id="queue-status" role="status"></p>
        <ul id="items" class="items"></ul>
      </section>
    </div>
  </div>

  <script is:inline type="module" define:vars={{ supabaseUrl, publishableKey }}>
    import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/+esm";

    const sb = createClient(supabaseUrl, publishableKey, { auth: { persistSession: true, detectSessionInUrl: true } });
    const FN = supabaseUrl + "/functions/v1/admin-review";
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    async function call(body) {
      const { data } = await sb.auth.getSession();
      const token = data.session?.access_token;
      if (!token) throw new Error("Sign in first.");
      const res = await fetch(FN, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + token, apikey: publishableKey },
        body: JSON.stringify(body),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(out.error || "Request failed.");
      return out;
    }

    function card(c) {
      const r = c.records || {};
      const meta = c.claude_json || {};
      const src = (c.source_urls || [])[0] || "";
      return `
        <li class="item" data-id="${esc(c.id)}">
          <h2><a href="/records/${esc(r.slug)}" target="_blank" rel="noopener">${esc(r.title)}</a></h2>
          <p class="now"><strong>Live now:</strong> ${esc(r.holder)} · ${esc(r.value_text)} · ${esc(r.achieved_on || "no date")}</p>
          <p class="meta">Submitted ${esc(new Date(c.created_at).toLocaleString())}${meta.email ? " · from " + esc(meta.email) : ""}</p>
          <p class="correction"><strong>Reported:</strong> ${esc(meta.correction || c.proposed_value_text)}</p>
          <p><strong>Source:</strong> ${src ? `<a href="${esc(src)}" target="_blank" rel="noopener nofollow">${esc(src)}</a>` : "none"}</p>
          <details open>
            <summary>Set the new values</summary>
            <div class="fields">
              <label>Holder <input data-k="holder" value="${esc(r.holder)}" /></label>
              <label>Figure (as shown) <input data-k="value_text" value="${esc(r.value_text)}" /></label>
              <label>Numeric value <input data-k="value_numeric" value="${esc(r.value_numeric)}" inputmode="decimal" /></label>
              <label>Unit <input data-k="unit" value="${esc(r.unit)}" /></label>
              <label>Date set (YYYY-MM-DD) <input data-k="achieved_on" value="${esc(r.achieved_on)}" placeholder="2026-10-03" /></label>
              <label>Location <input data-k="location" value="${esc(r.location)}" /></label>
            </div>
          </details>
          <div class="actions">
            <button type="button" data-act="approve">Approve and publish</button>
            <button type="button" data-act="hold">Hold</button>
            <button type="button" data-act="reject">Reject</button>
          </div>
          <p class="row-status" role="status"></p>
        </li>`;
    }

    async function loadQueue() {
      $("queue-status").textContent = "Loading...";
      try {
        const { items } = await call({ action: "list" });
        $("count").textContent = "(" + items.length + ")";
        $("items").innerHTML = items.map(card).join("") || "<li>Nothing waiting. Good.</li>";
        $("queue-status").textContent = "";
      } catch (e) {
        $("queue-status").textContent = e.message;
      }
    }

    const fmtDay = (d, opts) => new Date(d + "T12:00:00").toLocaleDateString(undefined, opts);
    const fmtTime = (t) => new Date(t).toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
    const money = (n) => "$" + Number(n || 0).toFixed(2);
    const kv = (rows) => rows.map(([k, v, warn]) => `<li${warn ? ' class="warn"' : ""}><span>${k}</span><strong>${v}</strong></li>`).join("");

    // What happened to each claim the news check found today.
    function findState(f) {
      if (f.status === "rejected") return ["Rejected", "bad"];
      if (f.record_status === "hidden") return ["Removed", "bad"];
      if (f.status === "pending") return ["Waiting", "wait"];
      if (f.record_id) return ["Updated a record", "ok"];
      return ["New, live", "ok"];
    }

    async function loadDashboard() {
      $("dash-status").textContent = "Loading...";
      try {
        const d = await call({ action: "dashboard", days: 14 });
        const today = d.daily[d.daily.length - 1] || {};
        const q = d.queues, t = d.totals;
        const live = d.today_news.filter((f) => !f.record_id && f.status !== "rejected" && f.record_status === "published").length;

        $("runline").innerHTML =
          `<strong>${esc(fmtDay(d.today, { weekday: "long", month: "long", day: "numeric" }))}.</strong> ` +
          (d.runs.count
            ? `News check ran ${d.runs.count} of 10 searches, last at ${esc(fmtTime(d.runs.last))}. ` +
              (d.runs.failed ? `<span class="badtxt">${d.runs.failed} failed.</span> ` : "No failures. ") +
              `Cost today ${money(today.cost)}.`
            : `<span class="badtxt">The news check has not run yet today.</span> It runs at about 6 AM.`);

        $("t-new").textContent = live;
        $("t-broken").textContent = today.broken ?? 0;
        $("t-live").textContent = t.published.toLocaleString();
        const a = d.audience || {};
        $("t-subs").textContent = (a.confirmed ?? 0).toLocaleString();
        $("audience").innerHTML = kv([
          ["Confirmed subscribers", (a.confirmed ?? 0).toLocaleString()],
          ["New this week", a.new_7d ?? 0],
          ["Signed up, not confirmed yet", a.pending ?? 0],
          ["Unsubscribed", a.unsubscribed ?? 0],
          ["Tips received / published", `${a.tips_total ?? 0} / ${a.tips_live ?? 0}`],
          ["Last weekly email", a.last_digest ? `${esc(fmtDay(String(a.last_digest.sent_at).slice(0, 10), { month: "short", day: "numeric" }))}, ${a.last_digest.recipients} sent` : "Not sent yet"],
        ]);
        $("t-wait").textContent = ((q.tips ?? 0) + q.corrections + q.news + q.recheck_breaks + q.recheck_figures).toLocaleString();

        $("finds").innerHTML = d.today_news.length
          ? d.today_news.map((f) => {
              const [label, cls] = findState(f);
              const name = f.slug && f.record_status === "published"
                ? `<a href="/records/${esc(f.slug)}" target="_blank" rel="noopener">${esc(f.title)}</a>`
                : esc(f.title);
              const src = f.sources < 2 ? `<span class="warntxt">${f.sources} source</span>` : `${f.sources} sources`;
              return `<li><span class="pill ${cls}">${label}</span><div><p class="ft">${name}</p>` +
                `<p class="fm">${esc(f.holder)} · ${esc(f.value_text)} · ${src}</p></div></li>`;
            }).join("")
          : "<li>Nothing found today.</li>";

        const max = Math.max(1, ...d.daily.map((x) => x.news_found));
        $("chart").innerHTML = d.daily.map((x) => {
          const h = Math.round((x.news_found / max) * 100);
          const tip = `${fmtDay(x.d, { month: "short", day: "numeric" })}: ${x.news_found} found, ${x.news_live} live, ${x.broken} broken, ${money(x.cost)}`;
          return `<div class="col" title="${esc(tip)}"><span class="v">${x.news_found || ""}</span>` +
            `<span class="bar" style="height:${h}%"></span>` +
            `<span class="d">${esc(fmtDay(x.d, { month: "numeric", day: "numeric" }))}</span></div>`;
        }).join("");
        $("daily-rows").innerHTML = d.daily.slice().reverse().map((x) =>
          `<tr><td>${esc(fmtDay(x.d, { weekday: "short", month: "short", day: "numeric" }))}</td><td>${x.news_found}</td>` +
          `<td>${x.news_live}</td><td>${x.added}</td><td>${x.broken}</td><td>${money(x.cost)}</td></tr>`).join("");

        $("queues").innerHTML = kv([
          ["Tips from visitors", q.tips ?? 0, (q.tips ?? 0) > 0],
          ["Corrections from visitors", q.corrections, q.corrections > 0],
          ["News finds held for review", q.news, q.news > 0],
          ["Recheck: possible new record holders", q.recheck_breaks, q.recheck_breaks > 0],
          ["Recheck: updated figures, same holder", q.recheck_figures, q.recheck_figures > 0],
          ["Researched drafts not published", q.drafts],
        ]);
        $("health").innerHTML = kv([
          ["Categories with records", t.categories],
          ["Old record pages (history)", t.history],
          ["Records with only 1 source", t.one_source, t.one_source > 0],
          ["Records without a picture", t.no_poster, t.no_poster > 0],
        ]);
        $("misses").innerHTML = d.search_misses.length
          ? kv(d.search_misses.map((m) => [esc(m.query), m.count + (m.count === 1 ? " search" : " searches")]))
          : "<li>None yet.</li>";

        $("dash-body").hidden = false;
        $("dash-status").textContent = "";
      } catch (e) {
        $("dash-status").textContent = e.message;
      }
    }

    // ---------- Tips ----------
    let tipCats = [];
    function tipCard(t) {
      const j = t.claude_json || {};
      const tip = j.tip || {};
      const state = j.state;
      const researched = state === "done";
      const badge = !researched
        ? `<span class="pill wait">${state === "error" ? "Research failed" : "Researching"}</span>`
        : j.is_record === false
          ? `<span class="pill bad">Doesn't look like a record</span>`
          : `<span class="pill ok">Looks real · ${esc(j.confidence || "?")} confidence</span>`;
      const cat = t.category_guess || j.category_slug || "";
      const catOpts = `<option value="">Pick a category</option>` +
        tipCats.map((c) => `<option value="${esc(c.slug)}"${c.slug === cat ? " selected" : ""}>${esc(c.name)}</option>`).join("");
      const f = (k, label, v, extra = "") => `<label>${label} <input data-k="${k}" value="${esc(v ?? "")}" ${extra}/></label>`;
      const matches = (t.matches || []).map((m, i) =>
        `<label class="match"><input type="radio" name="m-${esc(t.id)}" value="${esc(m.slug)}"${i === 0 ? " checked" : ""}/> ` +
        `<a href="/records/${esc(m.slug)}" target="_blank" rel="noopener">${esc(m.title)}</a> <span class="fm">${esc(m.holder)} · ${esc(m.value_text)}</span></label>`).join("");
      const sources = (t.source_urls || []).map((u) => `<li><a href="${esc(u)}" target="_blank" rel="noopener nofollow">${esc(u)}</a></li>`).join("");
      return `
        <li class="item" data-id="${esc(t.id)}">
          <div class="tip-head">${badge}<span class="meta">${esc(new Date(t.created_at).toLocaleString())}</span></div>
          <h2>${esc(j.title || tip.what)}</h2>
          <p class="correction"><strong>Visitor wrote:</strong> ${esc(tip.what)}${tip.details ? " · " + esc(tip.details) : ""}</p>
          <p><strong>Their link:</strong> <a href="${esc(tip.url)}" target="_blank" rel="noopener nofollow">${esc(tip.url)}</a></p>
          <p class="meta">${tip.name ? "From " + esc(tip.name) : "No name given"}${tip.email ? " · " + esc(tip.email) : ""}</p>
          ${j.auto_reason ? `<p class="why"><strong>Waiting for you because:</strong> ${esc(j.auto_reason)}</p>` : ""}
          ${researched && j.note ? `<p class="now"><strong>Research:</strong> ${esc(j.note)}</p>` : ""}
          ${state === "error" ? `<p class="row-status">${esc(j.error || "")}</p>` : ""}
          ${researched ? `
          <details open>
            <summary>Record details (edit before publishing)</summary>
            <div class="fields">
              ${f("title", "Title", j.title)}
              <label>Category <select data-k="category_slug">${catOpts}</select></label>
              ${f("holder", "Holder", t.proposed_holder)}
              ${f("value_text", "Figure (as shown)", t.proposed_value_text)}
              ${f("value_numeric", "Numeric value", t.proposed_value_numeric, 'inputmode="decimal"')}
              ${f("unit", "Unit", t.unit)}
              ${f("achieved_on", "Date set (YYYY-MM-DD)", j.achieved_on, 'placeholder="2026-10-03"')}
              ${f("location", "Location", j.location)}
              ${f("governing_body", "Official body", j.governing_body)}
              <label>Better is <select data-k="better_direction">
                <option value="higher"${j.better_direction !== "lower" ? " selected" : ""}>Higher</option>
                <option value="lower"${j.better_direction === "lower" ? " selected" : ""}>Lower</option></select></label>
            </div>
            ${sources ? `<p><strong>Sources:</strong></p><ul class="srcs">${sources}</ul>` : ""}
          </details>
          ${matches ? `<div class="matches"><p><strong>We may already have this record.</strong> Pick one to update it instead:</p>${matches}</div>` : ""}
          ${tip.name ? `<label class="credit"><input type="checkbox" data-credit checked /> Credit "Tipped by ${esc(tip.name)}"</label>` : ""}
          <div class="actions">
            <button type="button" data-act="tip_publish">Publish as new record</button>
            ${matches ? `<button type="button" data-act="tip_update">Update the picked record</button>` : ""}
            <button type="button" data-act="tip_reject">Reject</button>
          </div>` : `<div class="actions"><button type="button" data-act="tip_reject">Reject</button></div>`}
          <p class="row-status" role="status"></p>
        </li>`;
    }

    async function loadTips() {
      $("tips-status").textContent = "Loading...";
      try {
        const { items, categories } = await call({ action: "tips_list" });
        tipCats = categories || [];
        $("tip-count").textContent = "(" + items.length + ")";
        $("tip-items").innerHTML = items.map(tipCard).join("") || "<li>No tips waiting.</li>";
        $("tips-status").textContent = "";
      } catch (e) {
        $("tips-status").textContent = e.message;
      }
    }

    $("tip-items").addEventListener("click", async (e) => {
      const btn = e.target.closest("button[data-act]");
      if (!btn) return;
      const li = btn.closest(".item");
      const act = btn.dataset.act;
      const all = li.querySelectorAll(".row-status");
      const status = all[all.length - 1];
      if (act === "tip_reject" && !confirm("Reject this tip?")) return;
      const fields = {};
      li.querySelectorAll("[data-k]").forEach((i) => (fields[i.dataset.k] = i.value.trim()));
      const body = { action: act, candidate_id: li.dataset.id, fields, credit: !!li.querySelector("[data-credit]")?.checked };
      if (act === "tip_update") {
        body.record_slug = li.querySelector("input[type=radio]:checked")?.value || "";
        if (!confirm("Update that record? The current holder is kept as a history page.")) return;
      }
      const buttons = li.querySelectorAll("button");
      buttons.forEach((b) => (b.disabled = true));
      status.textContent = "Working...";
      try {
        const out = await call(body);
        li.innerHTML = act === "tip_reject"
          ? "<p>Rejected.</p>"
          : `<p>Done. <a href="/records/${esc(out.slug)}" target="_blank" rel="noopener">See the record</a>. The poster appears within a few minutes.</p>`;
        const left = $("tip-items").querySelectorAll(".item .actions").length;
        $("tip-count").textContent = "(" + left + ")";
      } catch (err) {
        status.textContent = err.message;
        buttons.forEach((b) => (b.disabled = false));
      }
    });

    $("export-subs").addEventListener("click", async () => {
      $("export-status").textContent = "Preparing...";
      try {
        const { csv, count } = await call({ action: "subscribers_csv" });
        const url = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
        const link = document.createElement("a");
        link.href = url;
        link.download = `brokenrecords-subscribers-${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        URL.revokeObjectURL(url);
        $("export-status").textContent = `${count} rows downloaded.`;
      } catch (e) {
        $("export-status").textContent = e.message;
      }
    });

    function showTab(name) {
      document.querySelectorAll(".tab").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tab === name)));
      $("dash").hidden = name !== "dash";
      $("tips").hidden = name !== "tips";
      $("queue").hidden = name !== "queue";
    }
    document.querySelectorAll(".tab").forEach((b) => b.addEventListener("click", () => showTab(b.dataset.tab)));

    let loaded = false;
    function showFor(session) {
      $("login").hidden = !!session;
      $("signed-in").hidden = !session;
      if (session && !loaded) {
        loaded = true;
        loadDashboard();
        loadTips();
        loadQueue();
      }
    }

    $("login-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      $("login-status").textContent = "Sending...";
      const { error } = await sb.auth.signInWithOtp({
        email: $("login-email").value.trim(),
        options: { shouldCreateUser: false, emailRedirectTo: location.origin + "/admin" },
      });
      $("login-status").textContent = error ? error.message : "Check your email for the sign-in link.";
    });

    $("signout").addEventListener("click", async () => {
      await sb.auth.signOut();
      location.reload();
    });

    $("items").addEventListener("click", async (e) => {
      const btn = e.target.closest("button[data-act]");
      if (!btn) return;
      const li = btn.closest(".item");
      const act = btn.dataset.act;
      const status = li.querySelector(".row-status");
      const buttons = li.querySelectorAll("button");
      if (act === "reject" && !confirm("Reject this report? It will be closed without changes.")) return;
      buttons.forEach((b) => (b.disabled = true));
      status.textContent = "Working...";
      const fields = {};
      li.querySelectorAll("[data-k]").forEach((i) => (fields[i.dataset.k] = i.value.trim()));
      try {
        const body = act === "approve"
          ? { action: "approve", candidate_id: li.dataset.id, fields }
          : { action: act, candidate_id: li.dataset.id };
        await call(body);
        li.remove();
        const left = $("items").querySelectorAll(".item").length;
        $("count").textContent = "(" + left + ")";
      } catch (err) {
        status.textContent = err.message;
        buttons.forEach((b) => (b.disabled = false));
      }
    });

    const { data } = await sb.auth.getSession();
    showFor(data.session);
    sb.auth.onAuthStateChange((_evt, session) => showFor(session));
  </script>

  <style is:global>
    .admin { padding-top: 2rem; padding-bottom: 3rem; max-width: 60rem; }
    .admin h2 { font: 800 1.1rem/1.2 var(--display); margin: 2rem 0 0.6rem; }
    .admin .tabs { display: flex; gap: 0.3rem; }
    .admin .tab { font-weight: 700; background: transparent; color: var(--ink); border-color: var(--rule); }
    .admin .tab[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .admin .runline { margin: 0 0 1rem; color: var(--ink-soft); }
    .admin .runline strong { color: var(--ink); }
    .admin .badtxt { color: var(--red); font-weight: 700; }
    .admin .warntxt { color: var(--red); }
    .admin .tiles { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
    .admin .tile { background: var(--board); color: #fff; border-radius: 8px; padding: 1rem; display: grid; gap: 0.3rem; }
    .admin .tile .n { font: 800 2.2rem/1 var(--display); color: var(--amber); font-variant-numeric: tabular-nums; }
    .admin .tile .l { font-size: 0.85rem; color: #c9d3dc; }
    .admin .hint { margin: -0.3rem 0 0.6rem; font-size: 0.9rem; color: var(--ink-soft); }
    .admin .finds { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
