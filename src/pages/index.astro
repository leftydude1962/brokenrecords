---
import Base from "../layouts/Base.astro";
import RecordCards from "../components/RecordCards.astro";
import { getCategories, getRecords, cacheFor } from "../lib/data";

const FEATURED = 10;
const [categories, records] = await Promise.all([getCategories(), getRecords()]);
const live = categories.filter((c) => (c.count ?? 0) > 0);
const counts = Object.fromEntries(live.map((c) => [c.slug, c.count ?? 0]));

// The front page shows 10 records, each from a different category. Records marked "featured"
// (the ones with video) come first; if fewer than 10 categories have one, the gap is filled with
// one record from another category, preferring records that already have a poster image.
const seen = new Set<string>();
const featured: typeof records = [];
const take = (r: (typeof records)[number]) => {
  const cat = r.categories?.slug;
  if (!cat || seen.has(cat) || featured.length >= FEATURED) return;
  seen.add(cat);
  featured.push(r);
};
records.filter((r) => r.featured).sort((a, b) => Number(!!b.video_url) - Number(!!a.video_url)).forEach(take);
records.filter((r) => !r.featured).sort((a, b) => Number(!!b.poster_url) - Number(!!a.poster_url)).forEach(take);
cacheFor(3600, Astro.response);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Broken Records",
  url: "https://brokenrecords.com",
};
---
<Base
  title="Broken Records: world records, kept current"
  description="Look up world records in sport, architecture, nature and people. Every record links to its sources and shows when it was last checked."
  jsonLd={jsonLd}
  image={featured.find((r) => r.poster_url)?.poster_url}
>
  <section class="band hero">
    <div class="wrap">
      <h1>World records, <span class="nowrap">kept current.</span></h1>
      <p class="lede muted">
        The fastest, tallest, longest and oldest. Pick one to see every record in its category, with sources and the date we last checked it.
      </p>
      <RecordCards records={featured} layout="five" categoryCounts={counts} />
    </div>
  </section>

  <div class="wrap">
    <section class="block" aria-labelledby="cats">
      <h2 id="cats">All {live.length} categories</h2>
      <ul class="cats">
        {live.map((c) => (
          <li>
            <a href={`/category/${c.slug}`}>
              <span class="num">{c.count}</span>
              <span class="cname">{c.name}</span>
              <span class="cunit">{c.count === 1 ? "record" : "records"}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero { padding-top: 2.5rem; padding-bottom: 3rem; }
  @media (min-width: 48rem) { .hero { padding-top: 4rem; padding-bottom: 4.5rem; } }
  .hero h1 { color: #fff; max-width: 18ch; font-size: clamp(2.3rem, 1.4rem + 4vw, 4.4rem); }
  .nowrap { white-space: nowrap; }
  .lede { max-width: 52ch; font-size: 1.2rem; margin: 1rem 0 2.25rem; }

  .block { margin-top: 3.5rem; }
  .block h2 { margin-bottom: 1.25rem; }
  .cats { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); border-top: 2px solid var(--ink); }
  .cats li { border-bottom: 1px solid var(--rule); }
  .cats a {
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 0.9rem;
    padding: 1rem 0.5rem; color: var(--ink); text-decoration: none; align-items: end;
  }
  .cats a:hover .cname { text-decoration: underline; }
  .num { grid-row: 1 / 3; font: 900 3.2rem/0.85 var(--display); font-stretch: 70%; color: var(--ink); font-variant-numeric: tabular-nums; }
  .cname { font: 800 1.35rem/1.1 var(--display); font-stretch: 105%; }
  .cunit { color: var(--ink-soft); font-size: 0.9rem; }
</style>
