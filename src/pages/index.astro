---
import Base from "../layouts/Base.astro";
import RecordCards from "../components/RecordCards.astro";
import LatestRecords from "../components/LatestRecords.astro";
import TipPrompt from "../components/TipPrompt.astro";
import AlertSignup from "../components/AlertSignup.astro";
import { getTaxonomy, getRecords, cacheFor, type RecordRow } from "../lib/data";
import { getJustBroken } from "../lib/latest";

const [{ sections, sectionOf }, records, latest] = await Promise.all([getTaxonomy(), getRecords(), getJustBroken(20)]);

// One card per section. The section's featured record (the one with a clip) leads; if a section
// has none, its first record with an image stands in, then any record.
const rank = (r: RecordRow) => (r.featured ? 0 : r.video_url ? 1 : r.poster_url ? 2 : 3);
const featured = sections
  .map((s) => records.filter((r) => r.categories && sectionOf[r.categories.slug]?.slug === s.slug).sort((a, b) => rank(a) - rank(b))[0])
  .filter((r): r is RecordRow => !!r);
cacheFor(3600, Astro.response);

// Totals for the hero. The total comes from the category counts, not records.length, because the
// records list is capped at 1,000 rows by the database API. "Broken this week" only counts records
// set in the last 7 days; it is left out when there are none.
const total = sections.reduce((n, s) => n + (s.count ?? 0), 0);
const brokenThisWeek = latest.days === 7 ? latest.items.filter((i) => i.is_broken).length : 0;
const fmt = (n: number) => n.toLocaleString("en-US");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Broken Records",
  url: "https://brokenrecords.com",
};
---
<Base
  title="Broken Records: world records, kept current"
  description="World records in sports, nature, architecture, animals, people, science, space, entertainment, food and money. Every record links to its sources."
  jsonLd={jsonLd}
  image={featured.find((r) => r.poster_url)?.poster_url}
>
  <section class="band hero">
    <div class="wrap">
      <h1>World records, <span class="nowrap">kept current.</span></h1>
      <p class="stats" aria-label="Site totals">
        <span><b>{fmt(total)}</b> world records in {sections.length} categories</span>
        {brokenThisWeek > 0 && <a href="#latest-h"><b>{brokenThisWeek}</b> broken this week</a>}
        <span>every record sourced</span>
      </p>
      <p class="lede muted">
        The fastest, tallest, longest and oldest. Pick a category to see every record inside it, with sources and the date we last checked it.
      </p>
      <RecordCards records={featured} layout="five" sectionOf={sectionOf} shuffle />
    </div>
  </section>

  <div class="wrap">
    <LatestRecords items={latest.items} heading={latest.days > 7 ? "Recently broken" : "Just Broken This Week"} byDay window={latest.days} />
    <AlertSignup source="home" />
  </div>

  <div class="wrap">
    <section class="block" aria-labelledby="cats">
      <h2 id="cats">Browse all {fmt(total)} records</h2>
      <div class="sections">
        {sections.map((s) => (
          <div class="sec">
            <a class="sec-h" href={`/category/${s.slug}`}>
              <span class="num">{s.count}</span>
              <span class="sname">{s.name}</span>
            </a>
            {s.children.filter((c) => (c.count ?? 0) > 0).length > 1 && (
              <ul class="subs">
                {s.children.filter((c) => (c.count ?? 0) > 0).map((c) => (
                  <li><a href={`/category/${c.slug}`}>{c.name}</a> <span class="n">{c.count}</span></li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
    <TipPrompt variant="band" />
  </div>
</Base>

<style>
  .hero { padding-top: 2.5rem; padding-bottom: 3rem; }
  @media (min-width: 48rem) { .hero { padding-top: 4rem; padding-bottom: 4.5rem; } }
  .hero h1 { color: #fff; max-width: 18ch; font-size: clamp(2.3rem, 1.4rem + 4vw, 4.4rem); }
  .nowrap { white-space: nowrap; }
  .lede { max-width: 52ch; font-size: 1.2rem; margin: 0.6rem 0 2.25rem; }
  .stats {
    display: flex; flex-wrap: wrap; gap: 0.35rem 0; margin: 1.1rem 0 0; color: #dfe6ec;
    font: 600 0.95rem/1.3 var(--display); letter-spacing: 0.02em;
  }
  .stats > * + *::before { content: "·"; margin: 0 0.6rem; color: rgb(255 255 255 / 0.45); }
  .stats b { color: var(--amber); font-weight: 800; font-variant-numeric: tabular-nums; }
  .stats a { color: inherit; text-decoration: underline; text-decoration-color: rgb(255 255 255 / 0.35); text-underline-offset: 3px; }
  .stats a:hover { text-decoration-color: var(--amber); }

  .block { margin-top: 3.5rem; }
  .block h2 { margin-bottom: 1.25rem; }
  .sections {
    display: grid; gap: 0 2rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    border-top: 2px solid var(--ink);
  }
  .sec { border-bottom: 1px solid var(--rule); padding: 1rem 0.25rem 1.1rem; }
  .sec-h { display: flex; align-items: baseline; gap: 0.8rem; color: var(--ink); text-decoration: none; }
  .sec-h:hover .sname { text-decoration: underline; }
  .num { font: 900 2.6rem/0.9 var(--display); font-stretch: 70%; font-variant-numeric: tabular-nums; min-width: 2.2ch; }
  .sname { font: 800 1.3rem/1.15 var(--display); font-stretch: 100%; }
  .subs { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; font-size: 0.95rem; }
  .subs a { color: var(--ink-soft); }
  .subs .n { color: var(--ink-soft); font-size: 0.8rem; opacity: 0.8; }
</style>
