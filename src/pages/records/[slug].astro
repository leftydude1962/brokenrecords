---
import Base from "../../layouts/Base.astro";
import Stat from "../../components/Stat.astro";
import RecordCards from "../../components/RecordCards.astro";
import Perspective from "../../components/Perspective.astro";
import { getRecord, getRecords, getTaxonomy, formatValue, formatMetric, formatDate, cacheFor } from "../../lib/data";

const record = await getRecord(Astro.params.slug!);
if (!record) {
  Astro.response.status = 404;
}
let related: Awaited<ReturnType<typeof getRecords>> = [];
const { sectionOf, categories } = await getTaxonomy();
const section = record?.categories ? sectionOf[record.categories.slug] ?? null : null;
const ownCat = record?.categories ? categories.find((c) => c.slug === record.categories!.slug) : undefined;
const isTopLevel = !!ownCat && !ownCat.parent_id;
if (record?.categories && ownCat) {
  related = (await getRecords({ categoryId: ownCat.id })).filter((r) => r.slug !== record.slug).sort((a, b) => Number(!!b.video_url) - Number(!!a.video_url)).slice(0, 4);
}
cacheFor(3600, Astro.response);

const v = record ? formatValue(record) : null;
const mv = record ? formatMetric(record) : null;
const usText = v ? `${v.value}${v.unit ? " " + v.unit : ""}` : "";
const metricText = mv ? `${mv.value}${mv.unit ? " " + mv.unit : ""}` : "";
const title = record ? `${record.title}: ${record.holder}, ${usText} | Broken Records` : "Record not found | Broken Records";
// A story the fact checker flagged (story.issues) stays hidden until it is fixed.
const story = record?.story?.sections?.length && !record.story.issues?.length ? record.story : null;
// Search snippet: the story's first sentence when there is one, cut at a word near 155 characters.
const firstSentence = story ? (story.sections[0].body.match(/^.+?[.!?](\s|$)/)?.[0] ?? story.sections[0].body).trim() : "";
const clip = (t: string, n = 158) => (t.length <= n ? t : t.slice(0, t.lastIndexOf(" ", n - 1)).replace(/[,;:]$/, "") + "...");
const description = record
  ? story
    ? clip(`${record.holder} holds the ${record.title.toLowerCase()} record at ${usText}. ${firstSentence}`)
    : `The ${record.title.toLowerCase()} record is held by ${record.holder} at ${usText}. Sources and last-checked date included.`
  : "This record does not exist.";
// One-sentence answer at the top of the page. Assistants and search snippets quote it, so it states the record, the holder, the date and the last check.
const setOn = record ? formatDate(record.achieved_on) : null;
const checkedOn = record ? formatDate(record.last_checked_at ?? null) : null;
const quick = record
  ? (record.status === "superseded"
      ? `This record, ${usText} by ${record.holder}${setOn ? `, set on ${setOn}` : ""}, has since been broken.`
      : `The current ${record.title.toLowerCase()} record is ${usText}, held by ${record.holder}${setOn ? `, set on ${setOn}` : ""}.`) +
    (checkedOn ? ` Last checked ${checkedOn}.` : "")
  : "";
const sourceDate = (d?: string | null) => (d ? new Date(d + "T12:00:00Z").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : null);
const pageUrl = record ? `https://brokenrecords.com/records/${record.slug}` : "";
// Sources, one card per page: the same link with or without "www." or a trailing slash shows once.
const normUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "").replace(/[?#].*$/, "").replace(/\/$/, "").toLowerCase();
const sources = record ? record.record_sources.filter((s, i, all) => all.findIndex((o) => normUrl(o.url) === normUrl(s.url)) === i) : [];
// Search engines cut long headlines with "..."; show a clean ellipsis instead.
const cleanTitle = (t?: string | null) => t?.replace(/\s*(\.\.\.|…)$/, "…") ?? null;
// No headline on file: build one from a readable link, like ".../taylor-swift-eras-tour-ticket-sales".
const titleFromUrl = (u: string) => {
  const seg = decodeURIComponent(new URL(u).pathname).split("/").filter(Boolean).reverse()
    .find((p) => /[a-z]/i.test(p) && p.split(/[-_]/).length >= 3);
  if (!seg) return null;
  const words = seg.replace(/\.[a-z]+$/i, "").split(/[-_]+/).filter((w) => w && !/^\d+$/.test(w));
  const t = words.join(" ");
  return t ? t[0].toUpperCase() + t.slice(1) : null;
};

const breadcrumbs = record && {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Broken Records", item: "https://brokenrecords.com/" },
    section && !isTopLevel && { "@type": "ListItem", name: section.name, item: `https://brokenrecords.com/category/${section.slug}` },
    record.categories && { "@type": "ListItem", name: record.categories.name, item: `https://brokenrecords.com/category/${record.categories.slug}` },
    { "@type": "ListItem", name: record.title, item: `https://brokenrecords.com/records/${record.slug}` },
  ].filter(Boolean).map((x, i) => ({ ...(x as object), position: i + 1 })),
};
// An Article entry tells search engines what the page is about, who holds the record and where the facts come from.
const article = record && story && {
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: `${record.title}: ${record.holder}, ${usText}`,
  description,
  image: record.poster_url ? [record.poster_url.split("?")[0]] : undefined,
  dateModified: record.story_at ?? record.updated_at ?? undefined,
  author: { "@type": "Organization", name: "Broken Records", url: "https://brokenrecords.com/" },
  publisher: { "@type": "Organization", name: "Broken Records", url: "https://brokenrecords.com/" },
  mainEntityOfPage: pageUrl,
  about: { "@type": "Thing", name: record.holder ?? record.title },
  articleSection: record.categories?.name,
  wordCount: story.sections.reduce((n, s) => n + s.body.split(" ").length, 0),
  citation: sources.map((s) => s.url),
};
const jsonLd = record && { "@context": "https://schema.org", "@graph": [breadcrumbs, article].filter(Boolean) };

const facts = record
  ? ([
      ["Holder", record.holder],
      ["Record", usText],
      ["Metric", metricText !== usText ? metricText : null],
      ["Exact figure", record.value_text && record.value_text !== usText && record.value_text !== metricText ? record.value_text : null],
      ["Location", record.location],
      ["Date set", formatDate(record.achieved_on)],
      ["Recognized by", record.governing_body],
      ["Last checked", formatDate(record.last_checked_at ?? null)],
    ].filter(([, val]) => val) as [string, string][])
  : [];
---
<Base title={title} description={description} noindex={!record} jsonLd={jsonLd} image={record?.poster_url}>
  {record ? (
    <article>
      <header class="band rec-band">
        <div class:list={["wrap", { "has-media": record.poster_url }]}>
          <div class="rec-main">
          <nav class="crumbs muted" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {section && !isTopLevel && <> / <a href={`/category/${section.slug}`}>{section.name}</a></>}
            {record.categories && <> / <a href={`/category/${record.categories.slug}`}>{record.categories.name}</a></>}
          </nav>
          <h1 class="rec-h1">{record.title}</h1>
          {quick && <p class="quick-answer">{quick}</p>}
          {record.status === "superseded" && <p class="flag">This record has been broken. It is kept here for history.</p>}
          <Stat record={record} />
          </div>
          {record.poster_url && (
            <figure class="rec-media" aria-hidden="true">
              <img src={record.poster_url} alt="" width="576" height="1024" />
              {record.video_url && <video src={record.video_url} poster={record.poster_url} muted loop playsinline autoplay preload="metadata" tabindex="-1"></video>}
            </figure>
          )}
        </div>
      </header>

      <div class="wrap">
        <dl class="facts">
          {facts.map(([k, val]) => (<div><dt>{k}</dt><dd>{val}</dd></div>))}
        </dl>

        {story && (
          <section class="story" aria-label="The story">
            {story.sections.map((sec) => (
              <>
                <h2>{sec.heading}</h2>
                <p>{sec.body}</p>
              </>
            ))}
          </section>
        )}

        <Perspective record={record} />

        <section class="sources" aria-labelledby="src">
          <h2 id="src">Sources</h2>
          <ul class="src-cards">
            {sources.map((s) => (
              <li>
                <a class="src-card" href={s.url} rel="noopener" target="_blank">
                  <span class="src-pub">
                    {(s.publisher ?? new URL(s.url).hostname).replace(/^www\./, "")}
                    {sourceDate(s.published_on) && <span class="src-date"> · {sourceDate(s.published_on)}</span>}
                  </span>
                  <span class="src-title">{cleanTitle(s.title) ?? titleFromUrl(s.url) ?? "Read the source"}</span>
                  {s.quote && <q class="src-quote">{s.quote}</q>}
                  {s.license && <span class="lic">{s.license}</span>}
                </a>
              </li>
            ))}
          </ul>
          <p class="note">Spotted an error or a newer record? Email <a href="mailto:info@brokenrecords.com">info@brokenrecords.com</a> with a source link.</p>
        </section>

        {related.length > 0 && record.categories && (
          <section class="related" aria-labelledby="rel">
            <h2 id="rel">More {record.categories.name.toLowerCase()} records</h2>
            <RecordCards records={related} numbered={false} />
          </section>
        )}
      </div>
    </article>
  ) : (
    <div class="wrap">
      <section class="missing">
        <h1>No record at this address.</h1>
        <p>The link may be old, or the record may have been renamed. <a href="/">Browse all records</a> instead.</p>
      </section>
    </div>
  )}
</Base>

<style>
  .rec-band { padding-bottom: 2.5rem; }
  .has-media { display: grid; gap: 1.5rem; }
  .rec-main { min-width: 0; }
  @media (min-width: 56rem) {
    .has-media { grid-template-columns: minmax(0, 1fr) 17rem; align-items: center; gap: 2.5rem; }
  }
  .rec-media { position: relative; margin: 0; border-radius: 6px; overflow: hidden; aspect-ratio: 9 / 16; max-width: 17rem; background: #0b1117; }
  @media (max-width: 55.99rem) { .rec-media { aspect-ratio: 4 / 5; max-width: none; } }
  .rec-media img, .rec-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .rec-media video { display: none; } }
  .crumbs { padding: 2rem 0 0.75rem; font-size: 0.95rem; }
  .rec-h1 { margin-bottom: 1.5rem; color: #fff; font-size: clamp(2.2rem, 1.3rem + 4vw, 4rem); }
  .quick-answer { color: #fff; font-size: 1.15rem; line-height: 1.5; max-width: 40rem; margin: -0.5rem 0 1.25rem; }
  .flag { background: var(--red); color: #fff; display: inline-block; padding: 0.3rem 0.7rem; border-radius: 4px; margin: 0 0 1rem; font-family: var(--display); font-weight: 600; }
  .facts { margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); gap: 1.25rem 1.5rem; }
  .facts div { border-top: 2px solid var(--ink); padding-top: 0.5rem; }
  .facts dt { font: 600 0.9rem/1.3 var(--display); color: var(--ink-soft); }
  .facts dd { margin: 0.2rem 0 0; font-size: 1.1rem; }
  .sources, .related { margin-top: 3rem; }
  .sources .note { margin-top: 1.25rem; }
  .sources h2, .related h2 { margin-bottom: 0.75rem; }
  .story { margin-top: 3rem; max-width: 42rem; }
  .story h2 { font-size: 1.45rem; margin: 2rem 0 0.5rem; }
  .story h2:first-child { margin-top: 0; }
  .story p { font-size: 1.15rem; line-height: 1.65; margin: 0; }
  .src-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .src-card { display: flex; flex-direction: column; gap: 0.45rem; height: 100%; box-sizing: border-box; padding: 1rem 1.1rem; border: 1px solid var(--rule); border-top: 3px solid var(--amber); border-radius: 4px; color: var(--ink); text-decoration: none; }
  .src-card:hover, .src-card:focus-visible { border-color: var(--ink); }
  .src-card:hover .src-title { text-decoration: underline; }
  .src-pub { font: 600 0.85rem/1.3 var(--display); text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft); }
  .src-date { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .src-title { font: 700 1.05rem/1.35 var(--display); color: var(--link); overflow-wrap: anywhere; }
  .src-quote { font-style: italic; color: var(--ink-soft); line-height: 1.5; }
  .lic { color: var(--ink-soft); font-size: 0.85rem; }
  .note { color: var(--ink-soft); max-width: 60ch; }
  .missing { padding: 4rem 0; }
  .missing p { max-width: 50ch; }
</style>
